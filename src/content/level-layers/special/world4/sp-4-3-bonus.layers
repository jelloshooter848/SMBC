;; sp-4-3-bonus: the original's pieces for the other map difficulties and for heroes with level flags
;; (generated by tools/levelgen/convert-smbc.mjs --layers from levelDataSpecial.xml; do not edit by hand).
;; Classic play lays, in order, each layer whose flags the hero has and whose difficulty is the
;; run's or any (level/layers.ts). The .map file holds Normal for a hero with no flags.

[layer easy]
2 4 $$
16 4 $$
2 5 $$$$$$$$$$$$$$$$
2 6 $$$$$$$$$$$$$$$$
2 7 $$$$$$$$$$$$$$$$
8 8 M
11 8 U

[layer hard]
6 13 .
8 13 ....
13 13 .
6 14 .
8 14 ....
13 14 .
+ icicle 5 4
+ icicle 9 4 dx=8
+ icicle 14 4

[layer vert]
2 8 ..
9 8 ..
16 8 ..
2 9 []
9 9 ##
16 9 []
-zone pipe 16 8 down -> sp-4-3 203 12 exit=up
+zone pipe 16 9 down -> sp-4-3 203 12 exit=up

[layer easy vert]
8 8 .
11 8 .
8 9 M
11 9 U
