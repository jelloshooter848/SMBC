;; sp-2-2-exit: the original's pieces for the other map difficulties and for heroes with level flags
;; (generated by tools/levelgen/convert-smbc.mjs --layers from levelDataSpecial.xml; do not edit by hand).
;; Classic play lays, in order, each layer whose flags the hero has and whose difficulty is the
;; run's or any (level/layers.ts). The .map file holds Normal for a hero with no flags.

[layer easy]
12 3 $$$
12 4 $$$
10 5 $$
10 6 $$
2 7 $$
8 7 $$
8 8 $$
6 9 $$
6 10 $$
0 11 $$
4 11 $$
0 12 $$
4 12 $$

[layer hard]
12 5 [].
12 6 {}.
10 7 ..{}.
10 8 ..{}.
8 9 []..{}.
8 10 {}..{}.
6 11 ..{}..{}.
6 12 ..{}..{}.
0 13 ww{}wwww{}ww{}wwww
21 13 ww
0 14 ..{}....{}..{}....
21 14 ..
+ piranha 2 10 red=1
+ piranha 8 9 red=1
+ piranha 12 5 red=1

[layer horz]
+ lift-fall 18 4 len=2 dx=8
