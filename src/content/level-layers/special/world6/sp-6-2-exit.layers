;; sp-6-2-exit: the original's pieces for the other map difficulties and for heroes with level flags
;; (generated by tools/levelgen/convert-smbc.mjs --layers from levelDataSpecial.xml; do not edit by hand).
;; Classic play lays, in order, each layer whose flags the hero has and whose difficulty is the
;; run's or any (level/layers.ts). The .map file holds Normal for a hero with no flags.

[layer easy]
6 2 $
2 3 $
6 3 U
11 3 $
2 4 ?
11 4 U
16 4 $
16 5 M
0 6 $
7 6 $
0 7 M
7 7 ?
14 7 $
3 8 $
10 8 $
14 8 U
3 9 U
8 9 $
10 9 ?
8 10 M
15 10 $$$
15 11 $
0 12 $$

[layer hard]
17 2 2
4 12 ..
8 12 ..
12 12 ..
0 13 []
4 13 []
8 13 []
12 13 []
0 14 {}
4 14 {}
8 14 {}
12 14 {}
+ piranha 0 13 red=1
+ piranha 4 13 red=1
+ piranha 8 13 red=1
+ piranha 12 13 red=1
+ block-item 17 2 item=bee
