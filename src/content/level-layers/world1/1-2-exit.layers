;; 1-2-exit: the original's pieces for the other map difficulties and for heroes with level flags
;; (generated by tools/levelgen/convert-smbc.mjs --layers from levelDataSmb.xml; do not edit by hand).
;; Classic play lays, in order, each layer whose flags the hero has and whose difficulty is the
;; run's or any (level/layers.ts). The .map file holds Normal for a hero with no flags.

[layer easy]
13 3 $$
12 4 $BB
11 5 $
14 5 B
10 6 $
14 6 B
9 7 $
14 7 B
8 8 $
14 8 B
7 9 $
14 9 B
6 10 $
14 10 B
5 11 $
14 11 B
14 12 B
- piranha 3 11

[layer hard]
11 6 .
11 7 .
9 8 .
11 8 .
8 9 ^.
11 9 .
7 10 .|.
11 10 .
3 11 ..
7 11 .|.
11 11 .
3 12 [].
7 12 .|.
11 12 .
0 13 ...{}.B.|.B.BB..mmmm..
0 14 ...{}.B.|.B.BB...ii...
- piranha 3 11
+ piranha 3 12
start 3 11 pipe-exit

[layer horz]
+ lift-fall 17 4 len=2 dx=8

[layer easy horz]
- lift-fall 17 4
+ lift-fall 18 4 len=2
