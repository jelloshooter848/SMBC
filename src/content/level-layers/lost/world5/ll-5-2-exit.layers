;; ll-5-2-exit: the original's pieces for the other map difficulties and for heroes with level flags
;; (generated by tools/levelgen/convert-smbc.mjs --layers from levelDataLostLevels.xml; do not edit by hand).
;; Classic play lays, in order, each layer whose flags the hero has and whose difficulty is the
;; run's or any (level/layers.ts). The .map file holds Normal for a hero with no flags.

[layer easy]
19 2 $$
18 3 $
17 4 $
19 4 BB
16 5 $
20 5 B
15 6 $
20 6 B
14 7 $
20 7 B
13 8 $
20 8 B
12 9 $
20 9 B
11 10 $
20 10 B
20 11 B
20 12 B

[layer hard]
18 5 []
26 5 .
17 6 .{}
16 7 ^.{}
15 8 .|.{}
14 9 ^.|.{}
26 9 .
13 10 .|.|.{}
12 11 ^.|.|.{}
6 12 5
10 12 =.|.|.|.{}
2 13 .{}.
11 13 .|.|.|.{}.
26 13 .
2 14 .{}.
11 14 .|.|.|.{}.
26 14 .
- piranha 3 11
+ piranha 3 11 red=1
+ piranha 18 5 red=1

[layer horz]
+ lift-fall 23 4 len=2 dx=8

[layer easy horz]
- lift-fall 23 4
+ lift-fall 24 4 len=2
