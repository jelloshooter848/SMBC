;; ll-8-4-end: the original's pieces for the other map difficulties and for heroes with level flags
;; (generated by tools/levelgen/convert-smbc.mjs --layers from levelDataLostLevels.xml; do not edit by hand).
;; Classic play lays, in order, each layer whose flags the hero has and whose difficulty is the
;; run's or any (level/layers.ts). The .map file holds Normal for a hero with no flags.

[layer easy]
11 7 M
1 9 .
7 11 %
12 11 %
- piranha 3 11
- piranha 10 11
+ piranha 3 11
+ piranha 10 11
+zone checkpoint 9 6

[layer hard]
1 2 2
4 2 %%%%%%%%
14 2 ?%
4 3 %%%%%%%%
15 3 %
15 4 %
1 5 2
14 5 U%
15 6 %
4 7 %%%%
15 7 %
1 8 2
7 8 %
14 8 M%
1 9 .
7 9 %
15 9 %
0 10 %
7 10 %
15 10 %
0 11 %
3 11 .[]
7 11 %
15 11 %
0 12 %%
3 12 .{}
7 12 %
14 12 %%
1 13 ~~~{}~%
9 13 ~
12 13 ~~~%
1 14 ...{}
7 14 %
9 14 .
15 14 %
- piranha 3 11
+ block-item 1 2 item=bee
+ piranha 4 11 red=1
+zone checkpoint 4 6
start 4 10 pipe-exit
