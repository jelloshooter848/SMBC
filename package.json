{
  "name": "smbc",
  "version": "0.4.20",
  "private": true,
  "description": "Super Mario Bros. Crossover: REMIX (SMBC REMIX), an unofficial browser remake of the fan game by Exploding Rabbit, with original art and music.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:levels": "vitest run src/content/levels",
    "check:assets": "node tools/check-no-binaries.mjs",
    "release:check": "node tools/release/check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
